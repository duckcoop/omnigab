# Models (downloaded at runtime, ~1+ GB)
models/*.gguf

# Local Data
vectorstore/
user_memory.json
data/model_state.json
data/*.sqlite3
data/memory.db

# Runtime state. None of this belongs in the repo: it is generated on the
# user's machine, differs per install, and storage.db holds personal
# memory (location, learned facts, application history).
data/storage.db
data/storage.db-journal
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/context_override.json
data/kev_catalog.json

# Generated resume drafts. These contain the user's real work history.
data/resume_drafts/
data/playwright_profile/
data/indeed_runs/
data/usajobs_runs/
data/docs/active_resume.*
data/docs/*resume*
job_results.pdf
logs/
logs/*.log
logs/audit.json
__pycache__/
*.pyc

# Packaging build artifacts. The editable install writes
# src/omnigab.egg-info/ next to the package dir, and a wheel build writes
# build/ and dist/. All three are generated from pyproject.toml.
*.egg-info/
build/
dist/

# Test run artifacts. verify.bat passes --cov, so every run of the gate
# leaves a binary .coverage database behind, and pytest caches the last
# failed set in .pytest_cache/.
.coverage
.coverage.*
.pytest_cache/

# Local agent config (not for distribution)
.claude/

# Scratch notes and working files. These are workflow artifacts, not part
# of the project, and they should never reach the repo.
COMMIT-THESE.md
PRIVACY-CHECK.md
FINDINGS.md
NOTES.md
TODO-scratch.md
*.scratch.md

# Environment
.env
venv/
.venv/

# OS
.DS_Store
Thumbs.db
Desktop.ini

# IDE
.vscode/
.idea/
*.swp

# HuggingFace cache
.cache/

# Runtime-only directories
models/

# Resume at the repository root. resume_ingest writes baseresume.txt from
# a baseresume.pdf or .docx dropped beside it, so all three hold the
# user's real name, address, and phone number. The data/ resume paths
# above were already ignored for this reason; these were missed because
# they sit at the root rather than under data/, and the file only appears
# once someone actually runs the app. Nothing has ever been committed.
baseresume.txt
baseresume.pdf
baseresume.docx
